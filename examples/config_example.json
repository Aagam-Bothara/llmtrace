{
  "output_dir": "./traces",
  "output_format": "jsonl",
  "gpu_sampler": {
    "sample_interval_ms": 100,
    "gpu_ids": null,
    "max_buffered_samples": 100000,
    "require_gpu": false
  },
  "energy": {
    "enabled": true,
    "attribution_method": "equal_share",
    "max_sample_gap_s": 1.0,
    "min_coverage_fraction": 0.5,
    "energy_price_usd_per_kwh": null
  },
  "autopsy": {
    "enabled": true,
    "queue_overload_threshold_ms": 100.0,
    "throttle_severity_threshold": 3,
    "memory_pressure_threshold_pct": 90.0,
    "low_gpu_util_threshold_pct": 50.0,
    "batch_fragmentation_threshold": 0.3
  },
  "reporter": {
    "cli_rich_output": true
  },
  "enable_batch_metadata": true,
  "collection_interval_s": 1.0,
  "max_buffered_events": 10000,
  "background_writes": true,
  "max_write_queue": 10000,
  "strict_instrumentation": false,
  "write_incomplete_requests": true
}